<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Remove unwanted query strings
    RewriteCond %{QUERY_STRING} no_mobile_theme
    RewriteRule ^(.*)$ /$1? [R=301,L]

    RewriteCond %{QUERY_STRING} ps_full_site=1
    RewriteRule ^(.*)$ /$1? [R=301,L]

    # Don't rewrite actual files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # SEO-friendly URL routing - map URLs to query parameters
    RewriteRule ^$ index.php [QSA,L]
    RewriteRule ^categoria/([a-z0-9-]+)/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&father=$1&cat=$2 [QSA,NC,L]
    RewriteRule ^categoria/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&father=$1 [QSA,NC,L]
    RewriteRule ^categoria/([a-z0-9-]+)/([a-z0-9-]+)/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&marca=$1&cat=$2&father=$3 [QSA,NC,L]
    RewriteRule ^produto/([a-z0-9-]+)/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=detalhes&id=$1&cod=$2 [QSA,NC,L]
    RewriteRule ^minha-conta$ index.php?m=cliente&c=cliente&a=conta [QSA,NC,L]
    RewriteRule ^meu-carrinho$ index.php?m=checkout&c=checkout&a=cesta [QSA,NC,L]
    RewriteRule ^current-checkout$ index.php?m=checkout&c=checkout&a=finalizar [QSA,NC,L]
    RewriteRule ^checkout$ index.php?m=checkout&c=checkout&a=current_checkout [QSA,NC,L]
    RewriteRule ^capturar-sessao$ index.php?m=pagamento&c=pagamento&a=iniciaPagamento [QSA,NC,L]
    RewriteRule ^finalizar-pedido$ index.php?m=checkout&c=checkout&a=finalizarPedido [QSA,NC,L]
    RewriteRule ^prazos-e-entregas$ index.php?m=produto&c=produto&a=prazos_e_entregas [QSA,NC,L]
    RewriteRule ^troca-e-devolucao$ index.php?m=produto&c=produto&a=trocas_e_devolucao [QSA,NC,L]
    RewriteRule ^faq-perguntas-frequentes$ index.php?m=produto&c=produto&a=faq [QSA,NC,L]
    RewriteRule ^cartao-mp-aprovado$ index.php?m=pagamento&c=pagamentoMP&a=aprovadoCartao [QSA,NC,L]
    RewriteRule ^boleto-mp-aprovado$ index.php?m=pagamento&c=pagamentoMP&a=aprovadoBoleto [QSA,NC,L]
    RewriteRule ^receive-clearsale-status$ index.php?m=pagamento&c=pagamentoPagarme&a=receberStatusTransacaoClear [QSA,NC,L]
    RewriteRule ^marca/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&marca=$1 [QSA,NC,L]
    RewriteRule ^marca/([a-z0-9-]+)/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&marca=$1&father=$2 [QSA,NC,L]
    RewriteRule ^marca/([a-z0-9-]+)/([a-z0-9-]+)/([a-z0-9-]+)$ index.php?m=produto&c=produto&a=lista&marca=$1&father=$2&cat=$3 [QSA,NC,L]
    RewriteRule ^2em1OFF$ index.php?m=produto&c=produto&a=detalhes&id=269&cod=conheca-a-incrivel-chapinha-que-faz-cachos-e-tambem-alisa [QSA,NC,L]
    RewriteRule ^datafeeds/vitas_shopping$ index.php?m=sistema&c=produto&a=catalogoXml [QSA,NC,L]
    RewriteRule ^tabela-atacado$ index.php?m=produto&c=produto&a=tabelaAtacado [QSA,NC,L]
    RewriteRule ^tabela-varejo$ index.php?m=produto&c=produto&a=tabelaVarejo [QSA,NC,L]
    RewriteRule ^ecomerce-admin$ index.php?m=sistema&c=login&a= [QSA,NC,L]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors On
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 512M
   php_value post_max_size 12M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php80"
   php_value upload_max_filesize 2M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors On
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value memory_limit 512M
   php_value post_max_size 12M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php80"
   php_value upload_max_filesize 2M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php80” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
